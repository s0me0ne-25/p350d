[Unit]
Description=Paging station daemon
RequiresMountsFor=/
Wants=time-sync.target
After=time-sync.target
# pigpiod must outlive pagerd on shutdown (units stop in reverse order)
Wants=pigpiod.service
After=pigpiod.service

[Service]
Type=simple
ExecStart=/opt/p350/pagerd
Restart=always
User=pagerd
Group=pagerd
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
