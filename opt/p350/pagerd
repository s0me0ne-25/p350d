def koi7encode(text):
        # Advisor codepage slightly differs from KOI7
        text = text.replace('ё', 'е')
        text = text.replace('Ё', 'Е')
        text = text.replace('Ъ', "'")
        text = text.replace('ъ', "'")

        koi8r = bytes(text,'koi8-r','replace')

        koi7=''
        for c in koi8r:
                koi7 += chr(c & 127)

        return koi7

def init_encoder():
