def buildBackgroundDigest():
    digest = emerman.getArchiveDigest()
    prefix = "СВОДКА" if (digest == EmergencyManager.ARCHIVE_EMPTY) else "АРХИВ"

    digest = prefix + datetime.now().strftime(" <%H:%M> / ") + digest

    return Message(CAPCODE_BACKGROUND, MSGTYPE, digest, 1)

def sendq():
    #global msgq
    global retxCounter
    global emerman

    emer_digest = emerman.getDigest()
    if (not emer_digest == None):
        pconf.config[PersistConfig.QMSG_MEM].insert(0, emer_digest)

    pconf.config[PersistConfig.QMSG_MEM].append(buildBackgroundDigest())

    wasTx = False
    if (retxCounter == 0) and (len(pconf.config[PersistConfig.QMSG_MEM]) > 0):
        for msg in pconf.config[PersistConfig.QMSG_MEM][:]:
            if (msg.needsRetx()):
                tx(msg, "ReTX > " + str(msg.capcode))
                msg.incRetxCount()
                debug ("Retx " + str(msg.retx_count) + "/" + str(msg.retx_max) + ": " + msg.text + ' (CC=' + str(msg.capcode) + ' type=' + str(msg.msgtype) + ')')
                wasTx = True
                time.sleep(RETX_COOLDOWN)    # let transmitter cool down
            else:
                pconf.config[PersistConfig.QMSG_MEM].remove(msg)
                debug ("Fully retxed: " + msg.text + ", removed")

        pconf.save()

    if not wasTx:
           ping()

    retxCounter = (retxCounter + 1) % RETX_STEP

def clrq():
    if (len(pconf.config[PersistConfig.QMSG_MEM]) > 1):     # Excluding digest
        for msg in pconf.config[PersistConfig.QMSG_MEM][:]:
            if (msg.capcode == CAPCODE):
                pconf.config[PersistConfig.QMSG_MEM].remove(msg)
                debug ("Removed by clrq(): " + msg.text)

        pconf.save()

def setPingTimer():
    global pingTimer

    if not 'pingTimer' in globals():
        pingTimer = RepeatTimer(PING_INTERVAL, sendq)

    try:
        pingTimer.cancel()
    finally:
        pingTimer = RepeatTimer(PING_INTERVAL, sendq)
        pingTimer.start()

    debug('Ping timer is reset, next=' + (datetime.now() + timedelta(seconds=PING_INTERVAL)).strftime("%H:%M:%S"))

class ControlHandler(socketserver.BaseRequestHandler):
    def handle(self):
        global pocsag, redButtonActive, THRESHOLD, HYSTER

        self.data = bytes.decode(self.request.recv(1024)).strip()
        #debug('Received via socket: ' + self.data)

        cmdArray = self.data.split(maxsplit=1)
        try:
            cmd = cmdArray[0]
        except:
            cmd = ''

        try:
            args = cmdArray[1]
        except:
            args = ''

#        debug('CMD = ' + cmd)
#        debug('ARGS = ' + args)

        response = ''
        if cmd == 'page':
            msg = args.strip()
            if msg == '':
                response = 'No message text specified'
            else:
                page(args)

        elif cmd == 'power':
            response += 'Voltage: ' + str(voltage) + '\n'
            supply = "Mains" if (powerState == PWRSTATE_AC) else "Battery"
            response += 'Supply: ' + supply + '\n'
            response += 'Low battery threshold: ' + str(THRESHOLD) + 'V\n'
            response += 'Threshold hysteresis: ±' + str(HYSTER) + 'V\n'
            response += 'Voltage drop on last TX: ' + lastTxDrop

        elif cmd == 'txenable':
            state = args.strip()
            if state == '1':
                pconf.config[PersistConfig.TX_STATE] = PersistConfig.TX_ENABLED
                pconf.save()
                response = 'Transmitter enabled'
                debug(response)
            elif state == '0':
                pconf.config[PersistConfig.TX_STATE] = PersistConfig.TX_DISABLED
                pconf.save()
                response = 'Transmitter disabled'
                debug(response)
            elif state == 'auto':
                pconf.config[PersistConfig.TX_STATE] = PersistConfig.TX_AUTO
                pconf.save()
                response = 'Transmitter control is set to auto (enabled when voltage is sufficient)'
                debug(response)
            else:
                response = 'Usage: txenable <0|1|auto>'

        elif cmd == 'jps':
            jps = dict()
            jps["voltage"] = floatVoltage()
            jps["pwrstate"] = powerState
            jps["tx_isenabled"] = pocsag.txEnabled
            jps["tx_isauto"] = ( pconf.config[PersistConfig.TX_STATE] == PersistConfig.TX_AUTO )
            jps["txauto_max"] = THRESHOLD + HYSTER
            jps["txauto_min"] = THRESHOLD - HYSTER
            response = json.dumps(jps,separators=(',', ':'))

        elif cmd == 'silent-restart':
            state = args.strip()
            if state == '1':
                response = 'Silent restart enabled'
                debug(response)
            elif state == '0':
                response = 'Silent restart disabled'
                debug(response)
            else:
                response = 'Usage: silent-restart <0|1>'

            pconf.config[PersistConfig.SILENT_RESTART] = (state == '1')
            pconf.save()

        # elif cmd == 'red-button':
            # state = args.strip()
            # if state == '1':
                # response = 'Red button alert activated'
                # debug(response)
                # redButtonActive = True
            # elif state == '0':
                # response = 'Red button alert cleared'
                # debug(response)
                # redButtonActive = False
            # else:
                # response = 'Usage: red-button <0|1>'

        elif cmd == 'get-pconf':
            response = json.dumps(pconf.config, separators=(',', ':'), cls=P350dEncoder)

        elif cmd == 'clrq':
            clrq()
            response = "Retx queue cleared"

        elif cmd == 'clra':
            emerman.getArchiveDigest(maxAgeSec=0, purgeOld=True)
            response = "Emergencies archive cleared"
            debug(response)

        elif cmd == 'help':
            response = """P350 POCSAG transmitter control system

Supported commands:
- page <text> -- Pages a message
- power -- Get transmitter power state
- jps -- Get [J]SON-encoded [P]ower [S]tate
- txenable <0|1|auto> -- Enable/disable real RF transmission (auto = enabled when voltage is sufficient)
- get-pconf -- Get station config in JSON
- clrq -- Clear retx queue
- clra -- Clear archived alerts
- silent-restart <0|1> -- Do not page system message on daemon start/stop
- help -- This help"""
            debug('Sent help back')
        else:
            response = 'Unknown command ' + cmd
            debug(response)

        self.request.sendall(str.encode(response + '\n'))

def serverThread():
    global server
    socketserver.TCPServer.allow_reuse_address = True
    server = socketserver.TCPServer(('127.0.0.1', CONTROL_PORT), ControlHandler)
    server.serve_forever()

def poweroffSwitch(channel=None):
    if (not GPIO.input(GPIO_POWER_SWITCH)): # Power switch sets the pin to 0 in OFF position
        response = 'SHUTTING DOWN PAGING SERVER NOW'
        debug(response)
        processPeripherals(sayBye=True)
        subprocess.run(["/usr/bin/sudo", "/usr/sbin/poweroff"], universal_newlines=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

def redButton(channel=None):
    global redButtonActive
    newState = not GPIO.input(GPIO_RED_BUTTON)

    if (newState == redButtonActive):
        return  # Nothing changed

    debug("redButton(): pin=" + str(GPIO.input(GPIO_RED_BUTTON)))
    redButtonActive = newState

def handle_exit(*args):
    global isTerminated
    global server
    global dispTimers
    global pingTimer

    if isTerminated:
        return          # Already terminated
    isTerminated = True

    debug('Received termination command')

    # Page the stop message first. On OS shutdown pigpiod may already be
    # stopped, and then the pigpio calls below raise; that must neither
    # prevent the message nor abort the rest of the cleanup.
    if not pconf.config[PersistConfig.SILENT_RESTART]:
        try:
            page(datetime.now().strftime("<%H:%M:%S> ") + STOPMSG)
        except Exception as e:
            debug('Failed to page stop message (' + repr(e) + ')')

    try:
        rx.cancel() # Cancel Virtual Wire receiver.
        pi.stop() # Disconnect from local Pi.
    except Exception as e:
        debug('pigpio cleanup failed (' + repr(e) + ')')

    for timer in dispTimers:
        timer.cancel()
    try:
        pingTimer.cancel()
    except:
        pass

    processPeripherals(sayBye=True)

    server.shutdown()
    pocsag.end()
    GPIO.cleanup()
    raise(SystemExit)

