def tx(msg, dispStatus):
    global lastTx, l2idle, voltdrop_measuring

    setPingTimer()

    if not pocsag.txEnabled:
        debug('Transmitter is disabled.')
        return

    l2idle = False
    voltdrop_measuring = True
    printLcd(2, dispStatus)
    init_encoder()

    cmd = 'P' + str(msg.capcode) + ',' + str(msg.msgtype) + ',' + ('' if msg.text == '' else koi7encode(msg.text))

    # --- Step 1 and 2: TOT limit calculation and repeat_safe adjustment ---
    text_len = len(msg.text) if msg.text else 0

    # 1. Calculate the length of one copy in words
    # Round up: ceil((text_len * 7) / 20) -> (text_len * 7 + 19) // 20
    mw = (text_len * 7 + 19) // 20
    words_per_copy = 1 + mw  # 1 address word + message words

    # 2. Calculate the available word budget within TX_TOT_LIMIT with a 10% margin
    dead_time = (PREKEY_MS + POSTKEY_MS) / 1000.0
    time_limit = (TX_TOT_LIMIT - dead_time) * 0.9
    max_bits = int(time_limit * BAUD_RATE)
    available_bits = max_bits - 576  # Leave space for the preamble
    max_batches = available_bits // 544 if available_bits >= 0 else 0
    max_total_words = max_batches * 16  # Maximum words we can afford

    # 3. How many copies can fit in this budget?
    max_possible_repeats = max_total_words // words_per_copy

    # Read the global REPEAT and cap it if necessary
    repeat_safe = min(REPEAT, max_possible_repeats)

    if repeat_safe <= 0:
        debug('Warning! Message exceeds TOT!')
        repeat_safe = 1

    debug(f'{words_per_copy} POCSAG words, {max_total_words} words per TOT budget => repeat factor={repeat_safe}')

    # --- Step 3: Physical transmission ---
    for i in range(repeat_safe):
        pocsag.safeWrite(cmd)

    lastTx = datetime.now()
    print_idle_async()

