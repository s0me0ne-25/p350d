class RepeatTimer(Timer):
    def run(self):
        while not self.finished.wait(self.interval):
            self.function(*self.args, **self.kwargs)

class P350dEncoder(json.JSONEncoder):
    def default(self, z):
        if isinstance(z, Message):
            return ({
                '__Message__':1,
                'capcode':z.capcode,
                'msgtype':z.msgtype,
                'text':z.text,
                'retx-max':z.retx_max,
                'retx-count':z.retx_count,
            })
        elif isinstance(z, Emergency):
            return ({
                '__Emergency__':1,
                'code':z.code,
                'start':z.start,
                'end':z.end,
                'resolved':z.resolved,
                'text':z.text,
            })
        elif isinstance(z, EmergencyManager):
            return ({
                '__EmergencyManager__':1,
                'emergs':z.emergs,
                'archive':z.archive,
                'strikes':z.strikes,
            })
        elif isinstance(z, datetime):
            return z.isoformat()

        else:
            super().default(self, z)

def safeParseIsoformat(iso):
    if (iso == None):
        return None

    try:
        d = datetime.fromisoformat(iso)
    except:
        d = None

    return d

def decode_p350d_types(z):
    if ('__Message__' in z):
        return Message(
            z['capcode'],
            z['msgtype'],
            z['text'],
            z['retx-max'],
            z['retx-count'],
        )
    elif ('__Emergency__' in z):
        buf = Emergency(z['code'])
        buf.start = safeParseIsoformat(z['start'])
        buf.end = safeParseIsoformat(z['end'])
        buf.resolved = z['resolved']
        buf.text = z['text']
        return buf
    elif ('__EmergencyManager__' in z):
        buf = EmergencyManager()
        buf.emergs = z['emergs']
        buf.archive = z['archive']
        buf.strikes = z['strikes']
        return buf

    # add types above
    return z

class Message(object):

    def __init__(self, capcode, msgtype, text, retx_max = 0, retx_count = 0):
        self.capcode = capcode
        self.msgtype = msgtype
        self.text = self.delUnsafeChars(text)
        self.retx_max = retx_max
        self.retx_count = retx_count

    def delUnsafeChars(self, s):
        return ' '.join(s.splitlines()).strip()

    def needsRetx(self):
        return (self.retx_count < self.retx_max)

    def incRetxCount(self):
        self.retx_count += 1

    def __str__(self):
        return str(self.__class__) + ": " + str(self.__dict__)

class Emergency(object):

    EMG_CODES = 3   # Number of codes below

    POWER_LOSS = 0
    NETWORK_LOSS = 1
    RED_BUTTON = 2

    startTexts = [
        "НЕТ 220 БАТ=%v",
        "НЕТ СЕТИ",
        "ТРЕВОЖНАЯ КНОПКА"
    ]

    endTexts = [
        "220 ОК",
        "СЕТЬ ОК",
        "СБРОС КНОПКИ"
    ]

    archiveTexts = [
       "НЕТ 220",
       "НЕТ СЕТИ",
       "ТРЕВОЖНАЯ КНОПКА"
    ]

    def __init__(self, code):
        self.code = code
        self.start = datetime.now()
        self.end = None
        self.resolved = False
        self.text = Emergency.startTexts[code]

    def substVars(self, text):
        global voltage
        text = text.replace("%v", str(floatVoltage()))

        return text

    def resolve(self):
        self.end = datetime.now()
        self.resolved = True
        # <START-END> for alerts longer than 1 min
        # else just <END> (considering the alert to be brief)
        dtSec = (self.end - self.start).seconds
        timestampPrefix = "<" if (dtSec <= 60) else self.start.strftime('<%H:%M-')
        self.text = timestampPrefix + self.end.strftime('%H:%M> ') + self.archiveTexts[self.code]
        return self.substVars(Emergency.endTexts[self.code])

    def getText(self):
        return self.substVars(self.text)


class EmergencyManager(object):

    MAX_STRIKES = 60

    ARCHIVE_EMPTY = "НЕТ ТРЕВОГ"
    #ARCHIVE_NONEMPTY = "АРХИВ ТРЕВОГ: "

    def __init__(self):
        self.emergs = [None]*Emergency.EMG_CODES
        self.strikes = [0]*Emergency.EMG_CODES
        self.archive = []

    def timestamp(self, dt=None):
        if (dt == None):
            dt = datetime.now()

        return dt.strftime("<%H:%M> ")

    def substVars(self, text):
        global voltage
        text = text.replace("%v", str(floatVoltage()))

        return text

    def emergStart(self, emgCode, maxStrikes = -1):
        if (self.emergs[emgCode] == None):

            if (maxStrikes == -1):
                maxStrikes = EmergencyManager.MAX_STRIKES

            debug("emergStart(): code=" + str(emgCode) + ", strikes=" + str(self.strikes[emgCode]), False, True)

            if (self.strikes[emgCode] < maxStrikes - 1):
                debug(", strikes incremented", True, False)
                self.strikes[emgCode] += 1
            else:
                debug(", we have real alert!", True, False)
                emerg = Emergency(emgCode)
                self.emergs[emgCode] = emerg
                msg = self.timestamp(emerg.start) + emerg.getText()

                pconf.save()

                return Message(CAPCODE, MSGTYPE, msg, 0)

    def emergEnd(self, emgCode):
        self.strikes[emgCode] = 0

        if isinstance(self.emergs[emgCode], Emergency):
            debug("emergEnd(): code=" + str(emgCode))

            # Mark emergency as resolved and get resolution message
            msg = self.timestamp() + self.emergs[emgCode].resolve()
            # Archive the emergency out
            self.archive.append(self.emergs[emgCode])
            self.emergs[emgCode] = None

            pconf.save()

            return Message(CAPCODE, MSGTYPE, msg, 0)

    def getDigest(self):
        digest = ""

        for emg in self.emergs:
            if isinstance(emg, Emergency):
                digest += (self.timestamp(emg.start) + emg.getText() + " / ")

        if digest == "":
            return None

        digest = digest[:-3]
        #return Message(CAPCODE, MSGTYPE, self.timestamp(emg.start) + digest, 1)
        return Message(CAPCODE, MSGTYPE, digest, 1)

    def getArchiveDigest(self, maxAgeSec = 86400, purgeOld = True):
        digest = ""

        d = datetime.now()
        wasPurge = False
        for emg in self.archive[:]:
            if (d - emg.end).total_seconds() < maxAgeSec:
                digest += (emg.getText() + " / ")
            elif purgeOld:
                self.archive.remove(emg)
                wasPurge = True

        if wasPurge:
            pconf.save()

        #return EmergencyManager.ARCHIVE_EMPTY if (digest == "") else (EmergencyManager.ARCHIVE_NONEMPTY + (digest[:-3]))
        return EmergencyManager.ARCHIVE_EMPTY if (digest == "") else (digest[:-3])

class PocsagSerial(serial.Serial):

    def __init__(self, port):
        super().__init__()
        self.baudrate=9600
        self.port = port
        self.timeout = 0.5
        self.txEnabled = True

    def start(self):
        retries = 0
        debug('Opening ' + SERIAL)

        while not self.is_open:
            try:
                self.open()
            except:
                time.sleep(0.2)
                retries += 1

        debug('Opened ' + SERIAL + ' in ' + str(retries) + ' retries')

    def end(self):
        retries = 0
        debug('Closing ' + SERIAL)

        while self.is_open:
            try:
                self.close()
            except:
                time.sleep(0.2)
                retries += 1

        debug('Closed ' + SERIAL + ' in ' + str(retries) + ' retries')

    def safeWrite(self, data):
        if not self.txEnabled:
            debug('Transmitter is disabled.')
            return
        if not self.is_open:
            debug('Writing to closed serial!')
            return
        #debug("To modulator: " + data, False, True)
        self.write(bytes(data + '\r', 'ascii'))
        self.flush()
        #retCode = self.read(2)[:-1].decode('ascii')
        #debug("; response = " + retCode, True, False)

class PersistConfig(object):
    TX_STATE = 'txenable'
    TX_DISABLED = 0
    TX_ENABLED = 1
    TX_AUTO = 2

    SILENT_RESTART = 'silent_restart'
    QMSG_MEM = 'qmsg_mem'
    EMERMAN = 'emerman'

    def __init__ (self, filename):
        self.config = {
            PersistConfig.TX_STATE: PersistConfig.TX_AUTO,
            PersistConfig.SILENT_RESTART: True,
            PersistConfig.QMSG_MEM: [],
            PersistConfig.EMERMAN: EmergencyManager()
        }
        self.filename = filename

        self.load()

    def load(self):
        try:
            with open(self.filename, "r") as f:
                loaded = json.load(f, object_hook=decode_p350d_types)
            # Keep defaults for any keys missing from the file
            self.config.update(loaded)
        except FileNotFoundError:
            debug("PConf not found, using defaults")
        except Exception as e:
            debug("PConf load failed (" + repr(e) + "), using defaults")
            # Keep the broken file for analysis; it will not be overwritten
            try:
                broken = self.filename + ".broken-" + datetime.now().strftime("%Y%m%d-%H%M%S")
                os.replace(self.filename, broken)
                debug("Broken PConf moved to " + broken)
            except Exception:
                pass

    def save(self):
        # Atomic write: temp file -> fsync -> rename.
        # The old pconf.json stays intact until the new one is fully on disk,
        # so a power loss mid-write can't leave an empty file behind.
        tmp = self.filename + ".tmp"
        try:
            with open(tmp, "w") as f:
                json.dump(self.config, f, cls=P350dEncoder)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, self.filename)
            dirfd = os.open(os.path.dirname(os.path.abspath(self.filename)), os.O_RDONLY)
            try:
                os.fsync(dirfd)
            finally:
                os.close(dirfd)
        except Exception as e:
            debug("PConf save failed (" + repr(e) + ")")

